{
  "compilerOptions": {
    "target": "ES2024",
    /*
      The main and preload bundles are produced by Vite
      (vite.electron.config.ts), so imports are resolved the way a
      bundler resolves them — extensionless — rather than the way Node
      resolves ESM. This config only type-checks; it emits nothing.
    */
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "skipLibCheck": true,
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitAny": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true
  },
  "include": [
    "**/*.ts",
    "../src/lib/electron/bridgeTypes.ts",
    "../src/lib/notes-worker/GitFs.ts",
    "../src/lib/notes/types/StorageProvider.ts",
    "../src/lib/notes/types/ByteRange.ts"
  ]
}
