<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+. The graph is not backed up with the app: a synced graph
  is backed up by its git remote, and restoring an old copy over a
  device that syncs would only fight it. The SSH key is sealed with a
  Keystore key, which never leaves the device, so a restored copy could
  not be opened anyway.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="graph" />
        <exclude domain="file" path=".ssh" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="graph" />
        <exclude domain="file" path=".ssh" />
    </device-transfer>
</data-extraction-rules>
